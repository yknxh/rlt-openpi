# Copy to .env (gitignored) and fill in. Each exp/*.sh auto-sources .env.

# Weights & Biases — get key from https://wandb.ai/authorize
WANDB_API_KEY=
# Optional: override default project / entity
# WANDB_PROJECT=rlt-openpi
# WANDB_ENTITY=

# LeRobot dataset root — defaults to ~/.cache/huggingface/lerobot if unset
# HF_LEROBOT_HOME=/path/to/datasets

# DROID teleop (only needed for exp/robot_*.sh on the real Franka rig)
# DROID_DIR=/path/to/droid
